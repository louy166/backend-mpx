# ===================================================================
# Modèle d'environnement (.env.example) — Foncier Mauritanie (MPX) API
# Copier ce fichier vers ".env" à la racine du projet :
#   cp .env.example .env   (ou Copy-Item .env.example .env sous PowerShell)
# Note : Ne pas entourer les valeurs de guillemets et utiliser "/" pour les chemins.
# ===================================================================

# --- Serveur HTTP ---
SERVER_PORT=8080

# --- Base de données PostgreSQL 17 / PostGIS 3.5 ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foncier_api
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Pool de connexions HikariCP ---
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_CONNECTION_TIMEOUT_MS=20000
DB_POOL_MAX_LIFETIME_MS=1200000

# --- JPA / Hibernate & Initialisation SQL ---
# En production : JPA_DDL_AUTO=validate et JPA_SHOW_SQL=false
SQL_INIT_MODE=always
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Téléversement Multipart & Stockage local ---
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=50MB
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8080

# --- CORS (séparer les origines par une virgule) ---
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.fonciermauritanie.mr,https://fonciermauritanie.mr

# --- Règles Métier & Tarification ---
UNLOCK_UNIT_PRICE_MRU=500
# En production : SEED_ENABLED=false
SEED_ENABLED=true

# --- Documentation OpenAPI 3.1 / Swagger UI ---
OPENAPI_DOCS_PATH=/v3/api-docs
SWAGGER_UI_PATH=/api/docs
SWAGGER_UI_ENABLED=true

# --- Sécurité JWT & Authentification OTP ---
# IMPORTANT : Générer une clé secrète aléatoire d'au moins 32 caractères (256 bits) en production
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_HMAC_SHA256_SECRET_KEY
JWT_ACCESS_EXP_MS=3600000
JWT_REFRESH_EXP_MS=2592000000
OTP_EXPIRATION_SECONDS=300
OTP_MAX_REQUESTS_PER_MINUTE=3
# En production : OTP_DEV_MODE=false (envoi SMS réel)
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# --- Niveaux de Logs ---
# En production : INFO / WARN
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_SQL_BIND=TRACE
